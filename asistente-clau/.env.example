# ─── Claude ────────────────────────────────────────────────────────────────
# https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Voz (opcional pero muy recomendado) ───────────────────────────────────
# Sin esto usa la voz del navegador, que suena robótica.
# Con esto suena como una persona. elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
# Dejalo vacío: la voz se elige desde Ajustes → Voz, dentro de la app.
ELEVENLABS_VOICE_ID=
# multilingual_v2 = mejor calidad (USD 0,10 / 1000 caracteres)
# flash_v2_5      = la mitad de precio y más rápido, algo menos de matiz
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Microsoft 365 / Outlook ───────────────────────────────────────────────
# Se sacan de portal.azure.com → Microsoft Entra ID → App registrations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" sirve para cualquier cuenta. Si la empresa tiene tenant propio,
# poné el Directory (tenant) ID que muestra Azure.
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── App ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Clave para entrar al panel (elegí una, se la pasás a ella)
APP_PASSWORD=cambiame
# Cualquier texto largo y aleatorio, firma la sesión
SESSION_SECRET=cambiame-por-algo-largo-y-aleatorio

# Datos de ella (para que el asistente sepa quién es "yo")
HER_NAME=
HER_EMAIL=
HER_ROLE=Ejecutiva de operaciones y comercio exterior
COMPANY=Empresa de briquetas de coco para narguile
TZ_HER=Asia/Jakarta
TZ_HQ=America/Asuncion

# Cada cuántos minutos revisa el correo
SYNC_INTERVAL_MIN=10

# Poné 1 para probar todo con correos de mentira, sin conectar Outlook
DEMO=0
